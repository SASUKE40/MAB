{
  "name": "mab-arena",
  "version": "1.0.0",
  "description": "Multi-armed bandit algorithms compared across problem settings: simulation core, CLI benchmark and an interactive web dashboard.",
  "main": "src/index.js",
  "license": "MIT",
  "scripts": {
    "test": "MAB_STRICT=1 node --test test/*.test.js",
