    "bench": "node scripts/benchmark.js",
    "bench:readme": "node scripts/benchmark.js --md results/benchmark.md --json results/benchmark.json",
    "serve": "python3 -m http.server 8000"
  },
  "engines": {
    "node": ">=18"
  }
}
